[node name="Underwater" type="MeshInstance3D"]
editor_description = "The water around a camera that is under it. A water node adds one; its colour and thickness come from the water's material."
visible = false
cast_shadow = 0
custom_aabb = AABB(-100000, -100000, -100000, 200000, 200000, 200000)
ignore_occlusion_culling = true
mesh = SubResource("quad")
script = ExtResource("script")
