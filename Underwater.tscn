[gd_scene format=3]

[ext_resource type="Script" path="res://addons/unpleasant_water/Core/WaterUnderwater.cs" id="script"]
[ext_resource type="Shader" path="res://addons/unpleasant_water/Shaders/Underwater.gdshader" id="shader"]

[sub_resource type="ShaderMaterial" id="look"]
render_priority = 100
shader = ExtResource("shader")

[sub_resource type="QuadMesh" id="quad"]
